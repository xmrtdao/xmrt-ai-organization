# XMRT AI Organization Environment Variables

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# AI Configuration
# (DeepSeek is now the default backend via eliza-direct — no API key needed)
DEEPSEEK_ENABLED=true

# Legacy AI Keys (kept for fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# XMRT Ecosystem
XMRT_ECOSYSTEM_URL=https://xmrt.io
XMRT_API_BASE_URL=https://api.xmrt.io

# Blockchain
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
ALCHEMY_API_KEY=
THIRDWEB_CLIENT_ID=

# Contracts
XMART_TOKEN_ADDRESS=
MONERO_POOL_ADDRESS=
CASH_DAPP_ADDRESS=

# Monero
MONERO_RPC_URL=http://localhost:18081
MONERO_POOL_WALLET=

# Database
DATABASE_URL=
REDIS_URL=

# Security
JWT_SECRET=change-this-in-production
ENCRYPTION_KEY=change-this-in-production

# APIs
COINGECKO_API_KEY=
DEFIPULSE_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000
